# Obligatoire, et sans valeur par défaut : `/api/auth/dev-login` n'est monté
# que pour `development` et `test`. Une variable absente ouvrait la route.
NODE_ENV=development

PORT=3000

MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mydb

# Au moins 32 caractères, et jamais la valeur d'exemple : il signe les cookies
# de session de tout le monde. `openssl rand -base64 32` en donne un.
SESSION_SECRET=remplacez-moi-par-32-caracteres-au-moins

GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET_HERE

# Obligatoire : la liste CORS en dépend. Absente, elle retombait sur
# localhost et le navigateur refusait tout le vrai domaine sans rien dire.
FRONTEND_URL=http://localhost:5173

# Ne sert qu'à `/api/auth/dev-login`, qui n'existe pas en production.
DEV_LOGIN_USER_ID=
